{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://flow-server.dev/contracts/v1/flow-review.schema.json",
  "title": "Deterministic flow review report",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "flowId", "generatedAt", "anchorRunId", "compareVersions", "runsAnalyzed", "runIds", "versions", "findings", "advisoryOnly"],
  "properties": {
    "schemaVersion": { "const": "v1" },
    "flowId": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,62}$" },
    "profileId": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,62}$" },
    "generatedAt": { "type": "string", "format": "date-time" },
    "anchorRunId": { "type": "string", "pattern": "^run_[a-z0-9-]{1,63}$" },
    "compareVersions": { "type": "boolean" },
    "runsAnalyzed": { "type": "integer", "minimum": 1, "maximum": 100 },
    "runIds": { "type": "array", "minItems": 1, "maxItems": 100, "items": { "type": "string", "pattern": "^run_[a-z0-9-]{1,63}$" } },
    "versions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["flowContentHash", "runsAnalyzed", "runIds", "successRate", "receiptsAnalyzed", "missingReceiptRuns", "runEvidence", "nodeMetrics"],
        "properties": {
          "flowContentHash": { "anyOf": [{ "type": "string", "pattern": "^[a-f0-9]{64}$" }, { "const": "unversioned" }] },
          "runsAnalyzed": { "type": "integer", "minimum": 1, "maximum": 100 },
          "runIds": { "type": "array", "minItems": 1, "maxItems": 100, "items": { "type": "string", "pattern": "^run_[a-z0-9-]{1,63}$" } },
          "successRate": { "type": "number", "minimum": 0, "maximum": 1 },
          "receiptsAnalyzed": { "type": "integer", "minimum": 0 },
          "missingReceiptRuns": { "type": "array", "maxItems": 100, "items": { "type": "string", "pattern": "^run_[a-z0-9-]{1,63}$" } },
          "runEvidence": {
            "type": "array",
            "minItems": 1,
            "maxItems": 100,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["runId", "completeness", "missingNodeIds", "unexpectedNodeIds"],
              "properties": {
                "runId": { "type": "string", "pattern": "^run_[a-z0-9-]{1,63}$" },
                "completeness": { "enum": ["complete", "incomplete", "unknown"] },
                "missingNodeIds": { "type": "array", "maxItems": 256, "items": { "type": "string", "pattern": "^[a-z][a-z0-9_-]{0,62}$" } },
                "unexpectedNodeIds": { "type": "array", "maxItems": 256, "items": { "type": "string", "pattern": "^[a-z][a-z0-9_-]{0,62}$" } }
              }
            }
          },
          "nodeMetrics": {
            "type": "array",
            "maxItems": 256,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["nodeId", "receipts", "completed", "failed", "skipped", "retries", "validationFailures", "signals", "missingMetrics", "successRate", "averageDurationMs"],
              "properties": {
                "nodeId": { "type": "string", "pattern": "^[a-z][a-z0-9_-]{0,62}$" },
                "receipts": { "type": "integer", "minimum": 1 },
                "completed": { "type": "integer", "minimum": 0 },
                "failed": { "type": "integer", "minimum": 0 },
                "skipped": { "type": "integer", "minimum": 0 },
                "retries": { "type": "integer", "minimum": 0 },
                "validationFailures": { "type": "integer", "minimum": 0 },
                "signals": { "type": "integer", "minimum": 0 },
                "missingMetrics": { "type": "integer", "minimum": 0 },
                "successRate": { "type": "number", "minimum": 0, "maximum": 1 },
                "averageDurationMs": { "type": ["integer", "null"], "minimum": 0 }
              }
            }
          }
        }
      }
    },
    "findings": {
      "type": "array",
      "maxItems": 8192,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "flowContentHash", "nodeId", "count"],
        "properties": {
          "code": { "enum": ["NODE_FAILURES_RECORDED", "NODE_RETRIES_RECORDED", "NODE_REVIEW_SIGNALS_RECORDED", "NODE_METRICS_MISSING", "NODE_RECEIPT_MISSING", "UNEXPECTED_NODE_RECEIPT"] },
          "flowContentHash": { "anyOf": [{ "type": "string", "pattern": "^[a-f0-9]{64}$" }, { "const": "unversioned" }] },
          "nodeId": { "type": "string", "pattern": "^[a-z][a-z0-9_-]{0,62}$" },
          "count": { "type": "integer", "minimum": 1 }
        }
      }
    },
    "advisoryOnly": { "const": true }
  }
}
