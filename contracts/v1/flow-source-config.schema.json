{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://flow-server.dev/contracts/v1/flow-source-config.schema.json",
  "title": "Local flow source configuration",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "sources"],
  "$defs": {
    "name": { "type": "string", "pattern": "^[A-Za-z0-9._:/-]{1,128}$" },
    "rules": { "type": "array", "maxItems": 64, "uniqueItems": true, "items": { "type": "string", "maxLength": 128, "pattern": "^!?[A-Za-z0-9._:/*-]+$" }, "anyOf": [{ "maxItems": 0 }, { "contains": { "type": "string", "pattern": "^[^!]" } }] }
  },
  "properties": {
    "schemaVersion": { "const": "v1" },
    "sources": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "mode", "path", "sync"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,62}$" },
          "mode": { "enum": ["local", "git"] },
          "path": { "type": "string", "minLength": 1, "maxLength": 4096 },
          "remote": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,62}$" },
          "branch": { "type": "string", "minLength": 1, "maxLength": 255 },
          "workspaceRoots": { "type": "array", "maxItems": 64, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 4096 } },
          "policy": {
            "type": "object", "additionalProperties": false,
            "properties": {
              "skills": { "$ref": "#/$defs/rules" }, "mcps": { "$ref": "#/$defs/rules" },
              "mcpRegistrations": { "type": "object", "maxProperties": 64, "propertyNames": { "$ref": "#/$defs/name" }, "additionalProperties": { "type": "object", "additionalProperties": false, "properties": { "codex": { "$ref": "#/$defs/name" }, "claude": { "$ref": "#/$defs/name" } } } }
            }
          },
          "execution": {
            "type": "object", "additionalProperties": false, "required": ["runtime"],
            "properties": {
              "runtime": { "enum": ["codex", "claude"] },
              "models": { "type": "object", "maxProperties": 64, "propertyNames": { "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,255}$" }, "additionalProperties": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,255}$" } },
              "efforts": { "type": "object", "propertyNames": { "enum": ["low", "medium", "high", "xhigh", "max", "ultra"] }, "additionalProperties": { "enum": ["low", "medium", "high", "xhigh", "max", "ultra"] } },
              "fallback": {
                "type": "object", "additionalProperties": false, "required": ["runtime", "models"],
                "properties": {
                  "runtime": { "enum": ["codex", "claude"] },
                  "models": { "type": "object", "maxProperties": 64, "propertyNames": { "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,255}$" }, "additionalProperties": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,255}$" } },
                  "agents": { "type": "object", "maxProperties": 32, "propertyNames": { "pattern": "^[a-z][a-z0-9_-]{0,62}$" }, "additionalProperties": { "type": "object", "additionalProperties": false, "required": ["model"], "properties": { "model": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,255}$" }, "effort": { "enum": ["low", "medium", "high", "xhigh", "max", "ultra"] } } } }
                }
              }
            }
          },
          "sync": {
            "type": "object",
            "additionalProperties": false,
            "required": ["pull", "push"],
            "properties": {
              "pull": { "const": "confirm" },
              "push": { "enum": ["manual", "confirm", "after-validation"] }
            }
          }
        }
      }
    }
  }
}
