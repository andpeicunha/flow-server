{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://flow-server.dev/contracts/v1/flow-document.schema.json",
  "title": "Flow document",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "nodes"],
  "properties": {
    "schemaVersion": { "const": "v1" },
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,62}$" },
    "title": { "type": "string", "minLength": 1, "maxLength": 160 },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,62}$" },
          "title": { "type": "string", "minLength": 1, "maxLength": 160 },
          "dependsOn": {
            "type": "array",
            "uniqueItems": true,
            "items": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,62}$" }
          }
        }
      }
    }
  }
}
