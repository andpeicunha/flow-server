{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://flow-server.dev/contracts/v1/run.schema.json",
  "title": "Run summary",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "flowId", "runtime", "executionMode", "status", "createdAt"],
  "properties": {
    "schemaVersion": { "const": "v1" },
    "id": { "type": "string", "pattern": "^run_[a-z0-9-]{1,63}$" },
    "flowId": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,62}$" },
    "profileId": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,62}$" },
    "flowSourceId": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,62}$" },
    "flowContentHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "flowGitCommit": { "type": "string", "pattern": "^[a-f0-9]{40,64}$" },
    "workspaceHead": { "type": "string", "pattern": "^[a-f0-9]{40,64}$" },
    "workspaceContextHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "openSpecHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "taskHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "reuseContextHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "reuseFromRunId": { "type": "string", "pattern": "^run_[a-z0-9-]{1,63}$" },
    "reusedNodeIds": { "type": "array", "maxItems": 128, "items": { "type": "string", "pattern": "^[a-z][a-z0-9_-]{0,62}$" } },
    "task": { "type": "string", "maxLength": 65536 },
    "runtime": { "enum": ["codex", "claude"] },
    "executionProfileId": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,62}$" },
    "availableExecutionProfiles": { "type": "array", "maxItems": 16, "items": { "type": "object", "additionalProperties": false, "required": ["id", "name", "runtime"], "properties": { "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,62}$" }, "name": { "type": "string", "minLength": 1, "maxLength": 80 }, "runtime": { "enum": ["codex", "claude"] } } } },
    "executionMode": { "enum": ["guided", "direct"] },
    "status": { "enum": ["created", "running", "paused", "blocked", "stopped", "completed", "failed"] },
    "createdAt": { "type": "string", "format": "date-time" },
    "block": { "type": "object", "additionalProperties": false, "required": ["reason", "recordedAt"], "properties": { "reason": { "type": "string", "maxLength": 2000 }, "details": { "type": "string", "maxLength": 2000 }, "nodeId": { "type": "string" }, "status": { "type": "string" }, "next": { "type": "string" }, "recordedAt": { "type": "string", "format": "date-time" } } },
    "blockHistory": { "type": "array", "items": { "type": "object" } },
    "nodeExecutions": { "type": "object", "additionalProperties": { "type": "object" } },
    "executionHistory": { "type": "array", "items": { "type": "object" } },
    "stop": { "type": "object" },
    "taskContextDelivered": { "type": "boolean" },
    "skillCapabilityWarnings": { "type": "object", "additionalProperties": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["code", "reason"], "properties": { "code": { "type": "string" }, "reason": { "type": "string" } } } } }
  },
  "allOf": [{ "if": { "required": ["flowSourceId"] }, "then": { "required": ["profileId"] } }]
}
