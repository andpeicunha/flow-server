{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://flow-server.dev/contracts/v1/receipt.schema.json",
  "title": "Redacted node receipt",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "runId", "nodeId", "status", "recordedAt"],
  "properties": {
    "schemaVersion": { "const": "v1" },
    "runId": { "type": "string", "pattern": "^run_[a-z0-9-]{1,63}$" },
    "nodeId": { "type": "string", "pattern": "^[a-z][a-z0-9_-]{0,62}$" },
    "status": { "enum": ["completed", "failed", "skipped"] },
    "recordedAt": { "type": "string", "format": "date-time" },
    "summary": { "type": "string", "maxLength": 4000 },
    "output": { "type": ["object", "array", "string", "number", "boolean", "null"] },
    "redactions": { "type": "integer", "minimum": 0 },
    "attempt": { "type": "integer", "minimum": 1, "maximum": 100 },
    "durationMs": { "type": "integer", "minimum": 0, "maximum": 604800000 },
    "agent": { "type": "string", "maxLength": 128 },
    "runtime": { "enum": ["codex", "claude"] },
    "model": { "type": "string", "maxLength": 256 },
    "effort": { "enum": ["low", "medium", "high", "xhigh", "max", "ultra"] },
    "tokenUsage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["inputTokens", "outputTokens"],
      "properties": {
        "inputTokens": { "type": "integer", "minimum": 0, "maximum": 1000000000 },
        "outputTokens": { "type": "integer", "minimum": 0, "maximum": 1000000000 }
      }
    },
    "orchestratorTokenUsage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["inputTokens", "outputTokens"],
      "properties": {
        "inputTokens": { "type": "integer", "minimum": 0, "maximum": 1000000000 },
        "outputTokens": { "type": "integer", "minimum": 0, "maximum": 1000000000 }
      }
    },
    "skills": {
      "type": "array",
      "maxItems": 32,
      "items": { "type": "string", "maxLength": 128 }
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "result"],
      "properties": {
        "mode": { "const": "deterministic" },
        "result": { "enum": ["passed", "failed", "not-run"] }
      }
    },
    "signals": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["severity", "code", "reason", "affectsRun"],
        "properties": {
          "severity": { "enum": ["info", "warning", "critical"] },
          "code": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]{0,63}$" },
          "reason": { "type": "string", "minLength": 1, "maxLength": 1000 },
          "affectsRun": { "const": false }
        }
      }
    },
    "reusedFrom": {
      "type": "object",
      "additionalProperties": false,
      "required": ["runId", "nodeId", "contextHash"],
      "properties": {
        "runId": { "type": "string", "pattern": "^run_[a-z0-9-]{1,63}$" },
        "nodeId": { "type": "string", "pattern": "^[a-z][a-z0-9_-]{0,62}$" },
        "contextHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "output": { "type": "object", "properties": { "reportPath": {}, "reportSha256": {} }, "required": ["reportPath"] } }, "required": ["output"] },
      "then": { "properties": { "output": {
        "type": "object",
        "required": ["reportSha256", "summary"],
        "properties": {
          "summary": { "type": "string", "maxLength": 4000 },
          "reportPath": { "type": "string", "pattern": "^reports/[a-z][a-z0-9_-]{0,62}\\.json$" },
          "reportSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
        }
      } } }
    },
    {
      "if": { "properties": { "output": { "type": "object", "properties": { "reportPath": {}, "reportSha256": {} }, "required": ["reportSha256"] } }, "required": ["output"] },
      "then": { "properties": { "output": { "type": "object", "properties": { "reportPath": {}, "summary": {} }, "required": ["reportPath", "summary"] } } }
    }
  ]
}
